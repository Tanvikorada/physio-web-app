// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String    @id @default(cuid())
  email     String?   @unique
  name      String?
  role      String    @default("patient")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  sessions  Session[]
}

model Exercise {
  id          String   @id @default(cuid())
  name        String
  description String?
  targetROM   Float?   // Clinically normative target range of motion
  
  // Phase 3: Escalation
  escalationFlag Boolean @default(false)
  escalationNote String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessions    Session[]
  painRecords PainRecord[]
}

model Session {
  id               String   @id @default(cuid())
  date             DateTime @default(now())
  
  // Phase 2: Persistence
  romAchieved      Float?
  formAccuracyScore Float?
  repCount         Int?
  
  // Phase 3 & 4 additions
  painScorePre     Int?
  painScorePost    Int?
  status           String   @default("completed") // completed, blocked
  blockedReason    String?

  // Relations
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  exerciseId       String
  exercise         Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  painRecords      PainRecord[]
}

model PainRecord {
  id         String   @id @default(cuid())
  painScore  Int
  timing     String   // "pre" or "post"
  timestamp  DateTime @default(now())

  sessionId  String
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
}
