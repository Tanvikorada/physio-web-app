// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id        String    @id @default(cuid())
  email     String?   @unique
  password  String?
  name      String?
  role      String    @default("patient")
  language  String    @default("en")
  largeText Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  sessions  Session[]
  savedExercises SavedExercise[]
}

model Exercise {
  id          String   @id @default(cuid())
  name        String
  description String?
  targetROM   Float?   // Clinically normative target range of motion
  
  // Phase A: Library
  categories          String[] // Array of categories this exercise belongs to
  trackingMode        String   @default("D") // A, B, C, D
  instructionsShort   String?
  instructionsFull    String?
  targetHoldSeconds   Int?
  landmarkConfig      Json?

  
  // Phase 3: Escalation
  isActive    Boolean  @default(true)
  escalationFlag Boolean @default(false)
  escalationNote String?

  // AI-generated plain-language pre-session briefing (cached, regenerated only if instructionsFull changes)
  aiBriefing     String?
  aiBriefingHash String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessions    Session[]
  painRecords PainRecord[]
  savedBy     SavedExercise[]
}

model Session {
  id               String   @id @default(cuid())
  date             DateTime @default(now())
  
  // Phase 2: Persistence
  romAchieved         Float?
  validRepCount       Int?
  rejectedRepCount    Int?
  formQualityFlags    String[]
  groqSessionFeedback String?
  formAccuracyScore   Float?
  
  // Phase 3 & 4 additions
  painScorePre     Int?
  painScorePost    Int?
  status           String   @default("completed") // completed, blocked
  blockedReason    String?

  // Relations
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  exerciseId       String
  exercise         Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  painRecords      PainRecord[]
}

model PainRecord {
  id         String   @id @default(cuid())
  painScore  Int
  timing     String   // "pre" or "post"
  timestamp  DateTime @default(now())

  sessionId  String
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
}

model SavedExercise {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  savedAt    DateTime @default(now())

  @@unique([userId, exerciseId])
}
